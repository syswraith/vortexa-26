# Server-side Supabase configuration for the backend.
#
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env, and never expose the service role key to clients.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Service role key (Project Settings -> API -> service_role).
# Required because ip_location_observations has RLS enabled with no policies.
SUPABASE_SERVICE_ROLE_KEY=
